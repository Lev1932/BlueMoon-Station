//  Починка сея от льва
// ═══════════════════════════════════════════════════════════════════════
//
// ПРОБЛЕМА: Игроки писали "улыбается* привет" и получали кринжовое 
//           дублирование с акцентом на эмоуте. Админы плакали. 
//           Лисы плакали. Все плакали. Даже сервер плакал.
//
// РЕШЕНИЕ:  Разделяем эмоут и речь через святую звездочку *.
//           Эмоут - чистый, без акцента. Речь - с акцентом.
//           Теперь можно РПшить как на ФФ, но без лага!
//
// БОНУС:    Автокапитализация после . ! ? 
//           (потому что мы не животные... хотя на этом сервере...)
//
// ═══════════════════════════════════════════════════════════════════════
//  АНЕКДОТ ДНЯ:
//  Заходит программист в бар. Заказывает 1 пиво. Заказывает 0 пива.
//  Заказывает 999999999 пива. Заказывает -1 пиво. Заказывает ящерицу.
//  Бармен говорит: "Всё работает отлично!"
//  Заходит обычный посетитель и спрашивает где туалет.
//  Бар загорается.
// ═══════════════════════════════════════════════════════════════════════
//
// ДИСКЛЕЙМЕР: Если этот код сломается и сервер упадёт - я не виноват.
//             Я просто лев. Львы не несут ответственности за баги.
//             Все претензии направлять к Смайли (он же основатель).
//
// P.S.   Особая благодарность Смайли - безумцу который создал BlueMoon.
//        Без него мы бы до сих пор страдали на Парадайзе.
//        Уважуха основателю, хотя сервер он назвал в честь луны, а не
//        себя. Скромность? На SS13? Подозрительно...
//
// P.P.S. Да, тут используется посимвольный цикл. Да, можно было regex.
//        Нет, я не буду переписывать. Если сообщение длиннее 500 символов
//        и сервер начинает умирать - это не баг, это фича. Меньше пишите,
//        больше РПшьте.
//
// P.P.P.S. Если ты читаешь эти комментарии в 3 часа ночи пытаясь понять
//          почему сервер крашнулся - проверь логи. Скорее всего кто-то
//          написал роман в одном сообщении. Опять.

/mob/living/say(message, bubble_type, list/spans = list(), sanitize = TRUE, datum/language/language = null, ignore_spam = FALSE, forced = null)
	// Проверяем есть ли звездочка в сообщении для разделения эмоута и речи
	var/star_position = findtext(message, "*")
	
	if(star_position && star_position > 1) // Звездочка найдена и не в начале
		// Разделяем на эмоут и речь (как Моисей разделил море)
		var/emote_part = trim(copytext(message, 1, star_position))
		var/speech_part = trim(copytext(message, star_position + 1))
		
		// Обрабатываем речевую часть если она есть
		if(speech_part)
			// Автокапитализация (потому что мы культурные дегенераты)
			speech_part = smart_capitalize(speech_part)
		
		// Сначала показываем эмоут (без акцента, чисто и няшно)
		if(emote_part)
			visible_message("<b>[src]</b> [emote_part]")
		
		// Потом обрабатываем речь (с акцентом) если она есть
		if(speech_part)
			message = speech_part
			return ..() // Вызываем родительский say() для обработки речи с акцентом
		
		return TRUE // Только эмоут без речи (тихий РП момент)
	
	// Обычная обработка если нет звездочки
	return ..()

// ═══════════════════════════════════════════════════════════════════════
//  SMART_CAPITALIZE - Функция для тех кто не умеет в Shift
// ═══════════════════════════════════════════════════════════════════════
// Капитализирует первую букву и после . ! ?
// Работает даже с "кавычками", 'апострофами' и «ёлочками»
//
// ВНИМАНИЕ: Эта функция использует цикл. Да, ЦИКЛ. В BYOND.
//           Если ваше сообщение длиннее "Войны и Мира" - сервер может
//           задуматься о смысле жизни на пару секунд. Это нормально.
//           Просто... пишите покороче, ладно?

/mob/living/proc/smart_capitalize(text)
	if(!text || length(text) < 2)
		return text
	
	var/result = ""
	var/capitalize_next = TRUE // Первая буква ВСЕГДА заглавная (это святое!)
	var/quote_chars = list("\"", "'", "«", "»", "'", "'", """, """) // Все виды кавычек
	
	// Начинаем священный ритуал посимвольной обработки
	// Если сервер лагает на этом моменте - вините того кто написал поэму
	for(var/i = 1, i <= length(text), i++)
		var/char = text[i]
		
		// Капитализируем первую букву (пропускаем пробелы и кавычки)
		if(capitalize_next)
			if(char != " " && !(char in quote_chars))
				char = uppertext(char)
				capitalize_next = FALSE
		
		result += char
		
		// После знаков препинания капитализируем следующую букву
		if(char == "." || char == "!" || char == "?")
			capitalize_next = TRUE
	
	return result

